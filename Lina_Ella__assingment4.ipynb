    "    model2.compile(optimizer=optimizer, loss='categorical_crossentropy', metrics=['accuracy'])\n",
    "\n",
    "    # Example usage\n",
    "    window_size = 100\n",
    "    stride = 10\n",
    "\n",
    "    X_train ,X_test,  y_train, y_test, encoder =get_test_train(feateng_X, y_bio)\n",
    "\n",
    "    X_train_sliding, y_train_sliding = create_sliding_windows(X_train,y_train, window_size, stride)\n",
    "    X_test_sliding, y_test_sliding = create_sliding_windows(X_test,y_test, window_size, stride)\n",
    "\n",
    "    batch_size = 64\n",
    "    epochs = 10\n",
    "    loss, accuracy = train_model( model2, epochs,batch_size,X_train_sliding, y_train_sliding, X_test_sliding,y_test_sliding)\n",
    "        \n",
    "\n",
