    "# Help functions\n",
    "\n",
    "\n",
    "# Video preprocessing function\n",
    "def preprocess_video(video_path, num_frames=50, target_size=(172, 172), windowing=False):\n",
    "    \"\"\"\n",
    "    Reads a video, resizes frames, and normalizes pixel values.\n",
    "    MoViNet expects a (T, H, W, C) tensor with T frames.\n",
    "    \"\"\"\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    frames = []\n",
    "    frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "\n",
    "    # Sample evenly spaced frames\n",
    "    if windowing:\n",
    "        indices = np.arange(0, frame_count, 15)  # Take every 5th fram --> 2 per sekund (för 30fps)\n",
    "    else:\n",
    "        indices = np.arange(0, frame_count, 3)  # Take every 3th fram --> 10 per sekund (för 30fps)\n",
    "\n",
    "    for idx in range(frame_count):\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "        if idx in indices:\n",
    "            frame = cv2.resize(frame, target_size)  # Resize size of image\n",
    "            frame = frame.astype(np.float32) / 255.0  # Normalize\n",
    "            frames.append(frame)\n",
    "\n",
    "    cap.release()\n",
    "\n",
    "    # Mirror the sequense\n",
    "    while len(frames) < num_frames:\n",
    "        mirrored_part = frames[::-1]  # Reverse the sequence\n",
    "        frames.extend(mirrored_part)\n",
    "    \n",
    "    # Chechs if sliding window is wanted or not, default is not\n",
    "    if windowing:\n",
    "        return np.array(frames, dtype=np.float32)  # Shape: (T, H, W, C)es\n",
    "    else:\n",
    "        frames = frames[:num_frames]  # Trim to exact num_frames\n",
    "\n",
    "    return np.array(frames, dtype=np.float32)  # Shape: (T, H, W, C)\n",
    "\n",
    "# Comapre trining lable with prediction\n",
    "def check_prediction(corr_label, pred_label):\n",
    "    \"\"\"\n",
    "    Compare if the predicted and true labels match and return true if that is the case.\n",
    "    If they do not match then false is returned\n",
    "    \"\"\"\n",
    "    if(corr_label == \"barbell biceps curl\"):\n",
    "        print(\"Barbell\")\n",
    "    elif(corr_label == \"bench press\" and pred_label == \"bench pressing\"):\n",
    "        return True\n",
    "    elif(corr_label == \"deadlift\" and pred_label == \"deadlifting\"):\n",
    "        return True\n",
    "    elif(corr_label == \"plank\"):\n",
    "        print(\"Plank\")\n",
    "    elif(corr_label == \"pull Up\" and pred_label == \"pull ups\"):\n",
    "        return True\n",
    "    elif(corr_label == \"push-up\" and pred_label == \"push up\"):\n",
    "        return True\n",
    "    elif(corr_label == \"shoulder press\"):\n",
    "        print(\"Shoulder press\")\n",
    "    elif(corr_label == \"squat\" and pred_label == \"squat\"):\n",
    "        return True\n",
    "    else:\n",
    "        return False\n",
    "\n",
    "# Split videos paths to training and test data\n",
    "def movinet_split_videos(dataset_path, test_split):\n",
    "    \"\"\"\n",
    "    Splits exercise videos into training and testing sets.\n",
    "\n",
    "    Iterates through each exercise folder, identifies video files,\n",
    "    and randomly splits them based on the given test_split ratio.\n",
    "    Stores the file paths and corresponding labels for later use.\n",
    "    \"\"\"    \n",
    "    \n",
    "    train_videos = []\n",
    "    test_videos = []\n",
    "\n",
    "    for exercise_folder in os.listdir(dataset_path):\n",
    "        exercise_path = os.path.join(dataset_path, exercise_folder)\n",
    "        \n",
    "        # Ensure it's a directory\n",
    "        if not os.path.isdir(exercise_path):\n",
    "            continue\n",
    "        print(f\"Processing: {exercise_path}\")\n",
    "        \n",
    "        # List video files\n",
    "        all_files = os.listdir(exercise_path)\n",
    "        video_files = [file for file in all_files if file.endswith(('.mp4', '.MOV'))]\n",
    "        print(f\"Total videos found in {exercise_folder}: {len(video_files)}\")\n",
    "\n",
    "        # Split into training and test \n",
    "        train_files, test_files = train_test_split(video_files, test_size=test_split, random_state=1)\n",
    "\n",
    "        # Store full paths for easier access later\n",
    "        train_videos.extend([(os.path.join(exercise_path, f), exercise_folder) for f in train_files])\n",
    "        test_videos.extend([(os.path.join(exercise_path, f), exercise_folder) for f in test_files])\n",
    "\n",
    "    print(f\"\\nTotal training videos: {len(train_videos)}\")\n",
    "    print(f\"Total testing videos: {len(test_videos)}\")  \n",
    "\n",
    "    return train_videos, test_videos\n",
    "\n",
    "def video_sliding_windows(video,label, num_frames=8, step=8):\n",
    "    \"\"\"\n",
    "    Takes preprocessed video frames and generates sliding windows.\n",
    "\n",
    "    Parameters:\n",
    "    - video_frames: numpy array of shape (T, H, W, C)\n",
    "    - num_frames: Number of frames per sequence\n",
    "    - step: Step size for sliding window\n",
    "\n",
    "    Returns:\n",
    "    - List of sequences, each of shape (num_frames, H, W, C)\n",
    "    \"\"\"\n",
    "    sequences = []  # Shape: (num_sequences, num_frames, H, W, C)\n",
    "    labels = []\n",
    "    total_frames = video.shape[0]\n",
    "\n",
    "    i=0\n",
    "    for start in range(0, total_frames - num_frames + 1, step):\n",
    "        if i>1:\n",
    "            return np.array(sequences, dtype=np.float32), np.array(labels) \n",
    "\n",
    "        sequences.append(video[start:start + num_frames])\n",
    "        labels.append(label)\n",
    "        i = i+1\n",
    "\n",
    "    return np.array(sequences, dtype=np.float32), np.array(labels) \n",
    "\n",
    "\n",
    "def load_videos(video_collection):\n",
    "    X = []\n",
    "    y = []\n",
    "\n",
    "    for video_path, label in video_collection:\n",
    "        # Ensure it's a video file (basic check)\n",
    "        if not video_path.lower().endswith((\".mp4\", \".mov\")):\n",
    "            continue\n",
    "\n",
    "        #print(video_path)\n",
    "        video = (preprocess_video(video_path, windowing=True))\n",
    "        X_sliding, y_sliding = video_sliding_windows(video, label)\n",
    "        \n",
    "        X.extend(X_sliding)\n",
    "        y.extend(y_sliding)\n",
    "    \n",
    "    return np.array(X), np.array(y)    \n"
   ]
