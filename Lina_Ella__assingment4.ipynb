    "import tensorflow as tf\n",
    "from tensorflow.keras import layers\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "class CustomModel(tf.keras.Model):\n",
    "    def __init__(self):\n",
    "        super(CustomModel, self).__init__()\n",
    "        # Take away padding\n",
    "        self.masking = layers.Masking(mask_value=0.0)\n",
    "\n",
    "        # First LSTM layer\n",
    "        self.lstm1 = layers.LSTM(128, return_sequences=True, input_shape=(50, 26))\n",
    "        self.batch_norm1 = layers.BatchNormalization()\n",
    "        self.dropout1 = layers.Dropout(0.3)\n",
    "\n",
    "        # Second LSTM layer\n",
    "        self.lstm2 = layers.LSTM(64, return_sequences=False)\n",
    "        self.batch_norm2 = layers.BatchNormalization()\n",
    "        self.dropout2 = layers.Dropout(0.3)\n",
    "\n",
    "        # Dense layers\n",
    "        self.dense1 = layers.Dense(32, activation='relu')\n",
    "        self.dense2 = layers.Dense(8, activation='softmax')\n",
    "\n",
    "    def call(self, inputs):\n",
    "        x = self.masking(inputs)\n",
    "\n",
    "        # First LSTM layer, batchnorm + dropout\n",
    "        x = self.lstm1(x)\n",
    "        x = self.batch_norm1(x)\n",
    "        x = self.dropout1(x)\n",
    "\n",
    "        # Second LSTM layer, batchnorm + dropout\n",
    "        x = self.lstm2(x)\n",
    "        x = self.batch_norm2(x)\n",
    "        x = self.dropout2(x)\n",
    "\n",
    "        # Dense lagers\n",
    "        x = self.dense1(x)\n",
    "        x = self.dense2(x)\n",
    "\n",
    "        return x\n"
