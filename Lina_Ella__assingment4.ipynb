    "\n",
    "# Loop through all exercise folders\n",
    "for exercise in os.listdir(root_dir):\n",
    "    if exercise in excluded_exercises:\n",
    "        continue\n",
    "    \n",
    "    exercise_folder=os.path.join(root_dir, exercise)\n",
    "    \n",
    "    # Ensure it's a directory\n",
    "    if not os.path.isdir(exercise_folder):\n",
    "        continue\n",
    "\n",
    "    print(f\"Processing: {exercise}\")\n",
    "\n",
    "    #i=0\n",
    "    # Loop through videos in each folder\n",
    "    for video in os.listdir(exercise_folder):\n",
    "        video_file = os.path.join(exercise_folder, video)\n",
    "        \n",
    "        # Ensure it's a video file (basic check)\n",
    "        if not video_file.lower().endswith((\".mp4\", \".mov\")):\n",
    "            continue\n",
    "        \n",
    "        #if(i<2):\n",
    "        # Preprocess video\n",
    "        video_tensor = preprocess_video(str(video_file))\n",
    "\n",
    "        # Expand dimensions to match model input: (1, T, H, W, C)\n",
    "        video_tensor = np.expand_dims(video_tensor, axis=0)\n",
    "\n",
    "        # Run inference\n",
    "        predictions = movinet_model({\"image\": video_tensor})\n",
    "        predicted_class = np.argmax(predictions)\n",
    "\n",
    "        corr_lable = exercise\n",
    "        pred_label = KINETICS_600_LABELS_LIST[predicted_class]\n",
    "        #print(f\"{corr_lable} - {pred_label}\")\n",
    "\n",
    "        if(check_prediction(corr_label=corr_lable, pred_label=pred_label)):\n",
    "            pred_accurat = pred_accurat+1\n",
    "        video_total = video_total+1\n",
    "\n",
    "            #i = i+1\n",
    "\n",
    "movinet_accuracy = pred_accurat/video_total * 100\n",
    "\n",
    "print(f\"Total videos: {video_total}\")\n",
    "print(f\"Accuracy: {movinet_accuracy:0.2f}\")"
